# Copiez ce fichier en .streamlit/secrets.toml (local) ou collez son contenu
# dans "Settings > Secrets" de Streamlit Cloud. Ne committez jamais vos clés.

OPENROUTER_API_KEY = "sk-or-v1-..."

# Optionnel : modèle sélectionné par défaut au démarrage (identifiant OpenRouter)
OPENROUTER_MODEL = "google/gemini-2.5-flash"

# Optionnel : identification de l'app dans les classements OpenRouter
OPENROUTER_SITE_URL = "https://votre-app.streamlit.app"
OPENROUTER_APP_NAME = "Dossier INSEE Expert"

# Clé API INSEE (métadonnées géographiques)
INSEE_API_KEY = "..."

# Optionnel : identifiants pynsee (sinon les valeurs par défaut du code sont utilisées)
PYNSEE_KEY = "..."
PYNSEE_SECRET = "..."
